<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity"
    android:padding="16dp">

    <!-- Small SOS Button (Top Right) -->

    <!-- Vertical SeekBar Container (Center Right) -->

    <!-- Main Torch Button (Centered) -->
    <Button
        android:id="@+id/btnSOS"
        android:layout_width="56dp"
        android:layout_height="55dp"
        android:layout_marginTop="76dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/sos_pattern"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/brightnessContainer"
        android:layout_width="41dp"
        android:layout_height="371dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.498">

        <SeekBar
            android:id="@+id/seekBarBrightness"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:max="1"
            android:progress="1"
            android:rotation="270"
            android:splitTrack="false" />
    </FrameLayout>

    <ToggleButton
        android:id="@+id/btnFlashlight"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:textOn=""
        android:textOff=""
        android:background="@drawable/round_toggle_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
